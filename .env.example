# Copy this file to .env and adjust if needed.
# These defaults match docker-compose.yml when running the app OUTSIDE the compose
# network (e.g. from a local venv) -- note the Mongo host port is 27018, not the
# standard 27017, because this machine also runs a native MongoDB service on the
# standard port and the container avoids clashing with it. Couchbase/Cassandra use
# their standard ports since nothing else on this machine runs them natively.
# The `app` service inside docker-compose.yml instead uses mongo:27017 / couchbase:8091
# / cassandra:9042 directly, since container-to-container traffic doesn't go through
# the remapped host ports.

MONGO_URI=mongodb://encbench_user:encbench_pass@localhost:27018/encbench?authSource=encbench

COUCHBASE_HOST=localhost
COUCHBASE_BUCKET=encbench
COUCHBASE_USER=encbench_user
COUCHBASE_PASSWORD=encbench_pass

CASSANDRA_CONTACT_POINTS=localhost
CASSANDRA_PORT=9042
CASSANDRA_KEYSPACE=encbench

ARANGO_URL=http://localhost:8529
ARANGO_DB=encbench
ARANGO_USER=root
ARANGO_PASSWORD=encbench_pass

# Master key for the client-side value-encryption layer (32 bytes, base64-encoded).
# Generate your own with: python -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())"
ENC_MASTER_KEY_B64=

# Separate secret for the B.4.1 real/decoy identification function (id(i)/isDecoy(i)).
# Deliberately independent of ENC_MASTER_KEY_B64 -- generate the same way.
DECOY_KEY_B64=
