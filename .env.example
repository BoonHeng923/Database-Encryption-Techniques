# Copy this file to .env and adjust if needed.
# These defaults match docker-compose.yml when running the app OUTSIDE the compose
# network (e.g. from a local venv) — note the host ports are 5433/27018, not the
# standard 5432/27017, because this machine also runs native Postgres/Mongo
# services on the standard ports and the containers avoid clashing with them.
# The `app` service inside docker-compose.yml instead uses postgres:5432 /
# mongo:27017 directly, since container-to-container traffic doesn't go through
# the remapped host ports.

POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=encbench
POSTGRES_USER=encbench_user
POSTGRES_PASSWORD=encbench_pass

MONGO_URI=mongodb://encbench_user:encbench_pass@localhost:27018/encbench?authSource=encbench

# Master key for the client-side encryption layer (32 bytes, base64-encoded).
# Generate your own with: python -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())"
ENC_MASTER_KEY_B64=

# Volume-hiding padding bucket size used by Approach C (records)
PAD_BUCKET_SIZE=50
